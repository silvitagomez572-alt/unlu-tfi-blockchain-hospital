{"apiVersion": "v1", "kind": "ConfigMap", "metadata": {"name": "hisjb-prom-config"}, "data": {"prometheus.yml": "{\"global\": {\"scrape_interval\": \"5s\", \"evaluation_interval\": \"5s\"}, \"rule_files\": [\"/config/rules.yml\"], \"scrape_configs\": [{\"job_name\": \"hisjb\", \"file_sd_configs\": [{\"files\": [\"/targets/targets.json\"], \"refresh_interval\": \"5s\"}]}]}", "rules.yml": "{\"groups\": [{\"name\": \"hisjb\", \"rules\": [{\"alert\": \"HISJBPendingTransactions\", \"expr\": \"pow_mempool_transactions > 0\", \"for\": \"10s\", \"labels\": {\"severity\": \"warning\"}, \"annotations\": {\"summary\": \"Transacciones pendientes de minado en {{ $labels.node }}\"}}, {\"alert\": \"HISJBNodeDown\", \"expr\": \"up{job=\\\"hisjb\\\"} == 0\", \"for\": \"15s\", \"labels\": {\"severity\": \"critical\"}}]}]}"}}