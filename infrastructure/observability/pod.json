{"apiVersion": "v1", "kind": "Pod", "metadata": {"name": "hisjb-observability", "labels": {"project": "hisjb-tfi", "app": "hisjb-observability"}}, "spec": {"automountServiceAccountToken": false, "securityContext": {"runAsNonRoot": true, "runAsUser": 472, "fsGroup": 472}, "containers": [{"name": "prometheus", "image": "quay.io/prometheus/prometheus:v3.15.0-distroless", "args": ["--config.file=/config/prometheus.yml", "--storage.tsdb.path=/prometheus", "--storage.tsdb.retention.time=2h"], "ports": [{"containerPort": 9090}], "resources": {"requests": {"cpu": "50m", "memory": "128Mi"}, "limits": {"cpu": "300m", "memory": "384Mi"}}, "volumeMounts": [{"name": "prom-config", "mountPath": "/config", "readOnly": true}, {"name": "targets", "mountPath": "/targets", "readOnly": true}, {"name": "prom-data", "mountPath": "/prometheus"}], "readinessProbe": {"httpGet": {"path": "/-/ready", "port": 9090}, "periodSeconds": 5}, "securityContext": {"allowPrivilegeEscalation": false, "capabilities": {"drop": ["ALL"]}}}, {"name": "grafana", "image": "grafana/grafana:13.2.3-distroless", "ports": [{"containerPort": 3000}], "env": [{"name": "GF_SECURITY_ADMIN_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "hisjb-grafana", "key": "password"}}}, {"name": "GF_PLUGINS_PREINSTALL_DISABLED", "value": "true"}, {"name": "GF_AUTH_ANONYMOUS_ENABLED", "value": "false"}, {"name": "GF_ANALYTICS_REPORTING_ENABLED", "value": "false"}, {"name": "LANG", "value": "en_US.UTF-8"}], "resources": {"requests": {"cpu": "50m", "memory": "128Mi"}, "limits": {"cpu": "500m", "memory": "512Mi"}}, "volumeMounts": [{"name": "graf-data", "mountPath": "/var/lib/grafana"}, {"name": "graf-config", "mountPath": "/etc/grafana/provisioning/datasources/hisjb.yml", "subPath": "datasources.yml", "readOnly": true}, {"name": "graf-config", "mountPath": "/etc/grafana/provisioning/dashboards/hisjb.yml", "subPath": "providers.yml", "readOnly": true}, {"name": "graf-config", "mountPath": "/dashboards/hisjb.json", "subPath": "dashboar